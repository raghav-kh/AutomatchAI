# Local dev default (SQLite):
DATABASE_URL=sqlite:///./automatch.db

# --- Supabase (Postgres) ---
# From your Supabase project: Settings -> Database -> Connection string -> URI.
# Use the psycopg3 dialect prefix (postgresql+psycopg://, not postgresql://).
#
# Two connection options Supabase gives you:
#   - Session pooler (port 6543, pgbouncer) -- recommended for serverless/
#     many short-lived connections. Works fine here; prepared statements
#     are already disabled for Postgres in app/core/database.py.
#   - Direct connection (port 5432) -- simpler, fine for a single long-lived
#     backend process like this one.
#
# DATABASE_URL=postgresql+psycopg://postgres.xxxxxxxx:[email protected]:5432/postgres
# DATABASE_URL=postgresql+psycopg://postgres.xxxxxxxx:[email protected]:6543/postgres

ENVIRONMENT=development

# --- Admin auth ---
# REQUIRED to change before deploying anywhere reachable. SECRET_KEY signs
# JWTs (generate with: python -c "import secrets; print(secrets.token_hex(32))").
# ADMIN_SETUP_KEY gates account registration -- there's no public sign-up;
# anyone with this key can create an admin account via POST /auth/register.
# The app logs a warning on startup if these are left at their defaults
# while ENVIRONMENT != development.
SECRET_KEY=dev-only-insecure-secret-change-me
ADMIN_SETUP_KEY=dev-only-insecure-setup-key-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Reserved for the AI recommendation/explanation engine - optional.
# Without it, explanations fall back to a template automatically.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
